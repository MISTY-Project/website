---
import { scienceGoals } from "../data/science-goals";
---

<section
  class="science-goals"
  aria-labelledby="science-goals-heading"
  data-science-goals
>
  <h2 id="science-goals-heading" class="section-title">Survey Science Goals</h2>

  <div class="science-goals__panel">
    <div class="science-goals__desktop-nav" data-goal-desktop-nav>
      <button
        type="button"
        class="science-goals__tabs-arrow"
        aria-label="Show previous science goal tabs"
        data-goal-tabs-prev
        disabled
      >
        <span aria-hidden="true">‹</span>
      </button>

      <div class="science-goals__tabs-track" data-goal-tabs-track>
        <div
          class="science-goals__tabs"
          role="tablist"
          aria-label="Survey science goals"
          data-goal-tabs
        >
          {
            scienceGoals.map((goal, index) => (
              <button
                type="button"
                class:list={["science-goals__tab", { "is-active": index === 0 }]}
                role="tab"
                id={`tab-${goal.id}`}
                aria-selected={index === 0 ? "true" : "false"}
                aria-controls={`panel-${goal.id}`}
                tabindex={index === 0 ? 0 : -1}
                data-goal-tab={goal.id}
                data-goal-label={goal.label}
              >
                {goal.label}
              </button>
            ))
          }
        </div>
      </div>

      <button
        type="button"
        class="science-goals__tabs-arrow"
        aria-label="Show next science goal tabs"
        data-goal-tabs-next
      >
        <span aria-hidden="true">›</span>
      </button>
    </div>

    <div class="science-goals__mobile-nav" data-goal-mobile-nav>
      <button
        type="button"
        class="science-goals__arrow"
        aria-label="Previous science goal"
        data-goal-prev
        disabled
      >
        <span aria-hidden="true">‹</span>
      </button>
      <p class="science-goals__mobile-label" data-goal-mobile-label>
        {scienceGoals[0]?.label ?? "Goal 1"}
      </p>
      <button
        type="button"
        class="science-goals__arrow"
        aria-label="Next science goal"
        data-goal-next
      >
        <span aria-hidden="true">›</span>
      </button>
    </div>

    <div class="science-goals__content">
      {
        scienceGoals.map((goal, index) => (
          <div
            class:list={[
              "science-goals__panel-body",
              { "is-active": index === 0 },
            ]}
            role="tabpanel"
            id={`panel-${goal.id}`}
            aria-labelledby={`tab-${goal.id}`}
            hidden={index !== 0}
            data-goal-panel={goal.id}
          >
            <h3 class="science-goals__title">{goal.title}</h3>
            <p class="science-goals__text">{goal.description}</p>
            <p class="science-goals__measure-lead">MISTY will measure:</p>
            <ul class="science-goals__measurements">
              {goal.measurements.map((item) => (
                <li set:html={item} />
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .science-goals {
    padding-bottom: 0.75rem;
    min-width: 0;
  }

  .science-goals .section-title {
    margin-bottom: 1.25rem;
  }

  .science-goals__panel {
    background-color: var(--surface-muted);
    border: 1px solid var(--rule);
    min-width: 0;
    overflow: hidden;
  }

  .science-goals__desktop-nav {
    display: none;
    align-items: stretch;
    gap: 0.15rem;
    border-bottom: 1px solid var(--rule);
    padding: 0.2rem 0.35rem;
    min-width: 0;
  }

  .science-goals__tabs-arrow {
    flex: 0 0 auto;
    align-self: center;
    width: 2.25rem;
    height: 2.25rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 0;
    border: 1px solid transparent;
    background: transparent;
    color: var(--navy);
    font-size: 1.35rem;
    line-height: 1;
    cursor: pointer;
  }

  .science-goals__tabs-arrow:hover:not(:disabled) {
    border-color: var(--rule);
    background: var(--surface-strong);
  }

  .science-goals__tabs-arrow:disabled {
    color: color-mix(in srgb, var(--text-muted) 55%, transparent);
    cursor: not-allowed;
    opacity: 0.55;
  }

  .science-goals__tabs-track {
    min-width: 0;
    flex: 1 1 auto;
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .science-goals__tabs-track::-webkit-scrollbar {
    display: none;
  }

  .science-goals__tabs {
    display: flex;
    flex-wrap: nowrap;
    gap: 0;
    width: max-content;
    min-width: 100%;
  }

  .science-goals__tab {
    appearance: none;
    flex: 0 0 auto;
    min-height: 2.95rem;
    margin: 0;
    padding: 0.8rem 1.15rem 0.75rem;
    border: 0;
    border-bottom: 2px solid transparent;
    background: transparent;
    color: var(--text-muted);
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    cursor: pointer;
    line-height: 1.3;
    white-space: nowrap;
  }

  .science-goals__tab:hover {
    color: var(--text);
  }

  .science-goals__tab.is-active {
    color: var(--navy);
    border-bottom-color: var(--navy);
    font-weight: 600;
  }

  .science-goals__mobile-nav {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr) 2.75rem;
    align-items: center;
    gap: 0.35rem;
    min-height: 3.25rem;
    padding: 0.35rem 0.5rem;
    border-bottom: 1px solid var(--rule);
  }

  .science-goals__arrow {
    width: 2.75rem;
    height: 2.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 0;
    border: 1px solid var(--rule);
    background: var(--surface-strong);
    color: var(--navy);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
  }

  .science-goals__arrow:hover:not(:disabled) {
    border-color: var(--navy);
  }

  .science-goals__arrow:disabled {
    color: color-mix(in srgb, var(--text-muted) 55%, transparent);
    border-color: color-mix(in srgb, var(--rule) 80%, transparent);
    background: color-mix(in srgb, var(--surface-muted) 70%, var(--surface));
    cursor: not-allowed;
    opacity: 0.7;
  }

  .science-goals__mobile-label {
    margin: 0;
    text-align: center;
    font-size: 1rem;
    font-weight: 600;
    color: var(--navy);
    line-height: 1.3;
    padding-inline: 0.35rem;
    overflow-wrap: anywhere;
  }

  .science-goals__content {
    padding: 1.35rem 1.2rem 1.55rem;
    background: var(--surface);
    min-width: 0;
  }

  .science-goals__title {
    margin: 0 0 0.65rem;
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .science-goals__text {
    margin: 0;
    max-width: var(--reading-max);
    color: var(--text-muted);
    line-height: 1.65;
  }

  .science-goals__measure-lead {
    margin: 1.1rem 0 0.45rem;
    max-width: var(--reading-max);
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--text);
    line-height: 1.45;
  }

  .science-goals__measurements {
    margin: 0;
    padding-left: 1.25rem;
    max-width: var(--reading-max);
    list-style: disc;
    color: var(--text-muted);
    line-height: 1.65;
    overflow-wrap: anywhere;
  }

  .science-goals__measurements li + li {
    margin-top: 0.4rem;
  }

  .science-goals__panel-body[hidden] {
    display: none;
  }

  @media (min-width: 768px) {
    .science-goals .section-title {
      margin-bottom: 1.4rem;
    }

    .science-goals__mobile-nav {
      display: none;
    }

    .science-goals__desktop-nav {
      display: flex;
    }

    .science-goals__tab {
      font-size: 1rem;
      padding-inline: 1.2rem;
      white-space: normal;
      max-width: 14.5rem;
      text-wrap: balance;
    }

    .science-goals__content {
      padding: 1.7rem 1.75rem 1.85rem;
    }

    .science-goals__measure-lead {
      margin-top: 1.25rem;
      font-size: 1rem;
    }

    .science-goals__measurements li + li {
      margin-top: 0.45rem;
    }
  }
</style>

<script>
  function getTabs(root: Element) {
    return Array.from(root.querySelectorAll<HTMLButtonElement>("[data-goal-tab]"));
  }

  function updateTabsScrollState(root: Element) {
    const track = root.querySelector<HTMLElement>("[data-goal-tabs-track]");
    const prev = root.querySelector<HTMLButtonElement>("[data-goal-tabs-prev]");
    const next = root.querySelector<HTMLButtonElement>("[data-goal-tabs-next]");
    if (!track || !prev || !next) return;

    const maxScroll = Math.max(0, track.scrollWidth - track.clientWidth);
    const atStart = track.scrollLeft <= 1;
    const atEnd = track.scrollLeft >= maxScroll - 1;

    prev.disabled = atStart || maxScroll <= 0;
    next.disabled = atEnd || maxScroll <= 0;
  }

  function scrollTabsBy(root: Element, direction: -1 | 1) {
    const track = root.querySelector<HTMLElement>("[data-goal-tabs-track]");
    if (!track) return;

    const amount = Math.max(120, Math.round(track.clientWidth * 0.75));
    track.scrollBy({ left: direction * amount, behavior: "smooth" });
  }

  function ensureTabVisible(root: Element, tab: HTMLElement) {
    const track = root.querySelector<HTMLElement>("[data-goal-tabs-track]");
    if (!track) return;

    const tabLeft = tab.offsetLeft;
    const tabRight = tabLeft + tab.offsetWidth;
    const viewLeft = track.scrollLeft;
    const viewRight = viewLeft + track.clientWidth;
    const pad = 12;

    if (tabLeft < viewLeft + pad) {
      track.scrollTo({ left: Math.max(0, tabLeft - pad), behavior: "smooth" });
    } else if (tabRight > viewRight - pad) {
      track.scrollTo({
        left: Math.max(0, tabRight - track.clientWidth + pad),
        behavior: "smooth",
      });
    } else {
      updateTabsScrollState(root);
    }
  }

  function activateGoal(root: Element, goalId: string) {
    const tabs = getTabs(root);
    const panels = root.querySelectorAll<HTMLElement>("[data-goal-panel]");
    const label = root.querySelector<HTMLElement>("[data-goal-mobile-label]");
    const prev = root.querySelector<HTMLButtonElement>("[data-goal-prev]");
    const next = root.querySelector<HTMLButtonElement>("[data-goal-next]");

    let activeIndex = 0;
    let activeTab: HTMLButtonElement | null = null;

    tabs.forEach((tab, index) => {
      const isActive = tab.dataset.goalTab === goalId;
      tab.classList.toggle("is-active", isActive);
      tab.setAttribute("aria-selected", String(isActive));
      tab.tabIndex = isActive ? 0 : -1;
      if (isActive) {
        activeIndex = index;
        activeTab = tab;
        if (label) {
          label.textContent = tab.dataset.goalLabel ?? tab.textContent ?? "";
        }
      }
    });

    panels.forEach((panel) => {
      const isActive = panel.dataset.goalPanel === goalId;
      panel.classList.toggle("is-active", isActive);
      panel.hidden = !isActive;
    });

    if (prev) {
      prev.disabled = activeIndex <= 0;
    }
    if (next) {
      next.disabled = activeIndex >= tabs.length - 1;
    }

    if (activeTab) {
      ensureTabVisible(root, activeTab);
    }
  }

  document.querySelectorAll("[data-science-goals]").forEach((root) => {
    const tabs = getTabs(root);
    const track = root.querySelector<HTMLElement>("[data-goal-tabs-track]");
    const tabsPrev = root.querySelector<HTMLButtonElement>("[data-goal-tabs-prev]");
    const tabsNext = root.querySelector<HTMLButtonElement>("[data-goal-tabs-next]");
    const goalPrev = root.querySelector<HTMLButtonElement>("[data-goal-prev]");
    const goalNext = root.querySelector<HTMLButtonElement>("[data-goal-next]");

    const getActiveIndex = () =>
      Math.max(
        0,
        tabs.findIndex((tab) => tab.classList.contains("is-active")),
      );

    root.addEventListener("click", (event) => {
      const target = event.target as HTMLElement | null;
      const tab = target?.closest<HTMLButtonElement>("[data-goal-tab]");
      if (tab && root.contains(tab) && tab.dataset.goalTab) {
        activateGoal(root, tab.dataset.goalTab);
      }
    });

    tabsPrev?.addEventListener("click", () => {
      if (tabsPrev.disabled) return;
      scrollTabsBy(root, -1);
    });

    tabsNext?.addEventListener("click", () => {
      if (tabsNext.disabled) return;
      scrollTabsBy(root, 1);
    });

    goalPrev?.addEventListener("click", () => {
      if (goalPrev.disabled) return;
      const index = getActiveIndex();
      const target = tabs[index - 1];
      if (!target?.dataset.goalTab) return;
      activateGoal(root, target.dataset.goalTab);
    });

    goalNext?.addEventListener("click", () => {
      if (goalNext.disabled) return;
      const index = getActiveIndex();
      const target = tabs[index + 1];
      if (!target?.dataset.goalTab) return;
      activateGoal(root, target.dataset.goalTab);
    });

    track?.addEventListener(
      "scroll",
      () => {
        updateTabsScrollState(root);
      },
      { passive: true },
    );

    window.addEventListener("resize", () => {
      const active = tabs.find((tab) => tab.classList.contains("is-active"));
      if (active) ensureTabVisible(root, active);
      else updateTabsScrollState(root);
    });

    root.addEventListener("keydown", (event) => {
      const target = event.target as HTMLElement | null;
      const current = target?.closest<HTMLButtonElement>("[data-goal-tab]");
      if (!current || !root.contains(current)) return;

      const index = tabs.indexOf(current);
      if (index < 0) return;

      let nextIndex = index;
      if (event.key === "ArrowRight" || event.key === "ArrowDown") {
        nextIndex = Math.min(index + 1, tabs.length - 1);
      } else if (event.key === "ArrowLeft" || event.key === "ArrowUp") {
        nextIndex = Math.max(index - 1, 0);
      } else if (event.key === "Home") {
        nextIndex = 0;
      } else if (event.key === "End") {
        nextIndex = tabs.length - 1;
      } else {
        return;
      }

      event.preventDefault();
      const nextTab = tabs[nextIndex];
      if (!nextTab?.dataset.goalTab) return;
      nextTab.focus();
      activateGoal(root, nextTab.dataset.goalTab);
    });

    if (tabs[0]?.dataset.goalTab) {
      activateGoal(root, tabs[0].dataset.goalTab);
    }
    updateTabsScrollState(root);
  });
</script>
