---
---

<footer class="site-footer">
  <div class="site-footer__inner site-shell">
    <p class="site-footer__brand">
      MISTY · Mapping the ISM and Stellar populations of TinY galaxies
    </p>
    <div class="site-footer__actions">
      <a
        class="site-footer__link"
        href="https://github.com/MISTY-Project"
        target="_blank"
        rel="noopener noreferrer"
      >
        GitHub
      </a>
      <a class="site-footer__contact" href="mailto:misty.survey.team@gmail.com">Contact</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--rule);
    margin-top: auto;
    background: var(--surface);
  }

  .site-footer__inner {
    padding-block: 1.5rem 1.75rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .site-footer__brand {
    margin: 0;
    max-width: 38rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--text-muted);
  }

  .site-footer__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem 1.25rem;
  }

  .site-footer__link {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.03em;
  }

  .site-footer__link:hover {
    color: var(--navy);
  }

  .site-footer__contact {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.35rem;
    padding: 0.45rem 1rem;
    border: 1px solid var(--rule);
    background: var(--surface-strong);
    color: var(--text);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.03em;
  }

  .site-footer__contact:hover {
    border-color: var(--navy);
    color: var(--navy);
  }

  @media (min-width: 768px) {
    .site-footer__inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
      padding-block: 1.65rem 1.9rem;
    }
  }
</style>
